<% if has_link_to_resource? && link_whole_card? %>
  <a href="<%= resource_path %>" class="<%= item_list_class %>" id="<%= resource_id %>"<% html_options.each do |k, v| %> <%= k %>="<%= v %>"<% end %>>
    <%= render :content %>
    <%= render :extra_data if render_extra_data? %>
  </a>
<% else %>
  <div class="<%= wrapper_class %>" id="<%= resource_id %>">
    <div class="<%= item_list_class %>">
      <%= render :content %>
    </div>
    <%= render :extra_data if render_extra_data? %>
  </div>
<% end %>

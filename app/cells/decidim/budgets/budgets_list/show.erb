<% if voting_finished? %>
  <div id="budgets" class="card__list-list">
    <% budgets.each do |budget| %>
      <%= cell("decidim/budgets/budget_list_item", budget) %>
    <% end %>
  </div>
<% else %>
  <div id="budgets" class="card__list-list">
    <% if votable_budgets.any? %>
      <% if voted? %>
        <p class="h6"><%= t(".voting_possible") %></p>
      <% end %>

      <% votable_budgets.each do |budget| %>
        <%= cell("decidim/budgets/budget_list_item", budget) %>
      <% end %>
    <% end %>

    <% if not_votable_budgets.any? %>
      <p class="h6"><%= t(".voting_prohibited") %></p>
      <% not_votable_budgets.each do |budget| %>
        <%= cell("decidim/budgets/budget_list_item", budget) %>
      <% end %>
    <% end %>

    <% if voted? %>
      <p class="h6"><%= t(".voted") %></p>
      <div id="voted-budgets" class="card__list-list">
        <% voted.each do |budget| %>
          <%= cell("decidim/budgets/budget_list_item", budget) %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<%= decidim_paginate budget_paginate %>
